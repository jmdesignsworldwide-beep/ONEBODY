# ============================================================================
# ONEBODY — Variables de entorno (plantilla)
# ----------------------------------------------------------------------------
# Copia este archivo como `.env.local` y rellena los valores reales.
# NUNCA subas `.env.local` al repositorio. NUNCA pongas secretos aquí.
# La clave `service_role` es SOLO server-side — jamás con prefijo NEXT_PUBLIC_.
# ============================================================================

# ---- Supabase (Tanda 2) ----------------------------------------------------
# URL pública del proyecto Supabase. Segura para el cliente.
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima (RLS aplica). Segura para el cliente.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role — SOLO SERVIDOR. Marcar como "Sensitive" en Vercel.
# Bypassa RLS: nunca exponer al cliente, nunca loguear, nunca en respuestas API.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Capa de pagos (Tanda 8) ----------------------------------------------
# Proveedor activo: mock | stripe | paypal
PAYMENT_PROVIDER=mock

# Secreto de verificación de firma de webhook (por proveedor).
PAYMENT_WEBHOOK_SECRET=

# ---- Sitio --------------------------------------------------------------
# URL canónica del sitio (producción). Usada por metadata y sitemaps.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Acceso social / OAuth (Pieza 1) --------------------------------------
# Las credenciales (Client ID/Secret) de Google, Apple y Facebook NO van aquí:
# se configuran en Supabase → Authentication → Providers y en cada consola del
# proveedor. Nunca pongas secretos de OAuth en variables NEXT_PUBLIC_.
#
# Proveedores sociales visibles en la pantalla de acceso (lista separada por
# comas). Si se deja vacío, se muestran los tres (google,apple,facebook).
# Restríngela a los proveedores YA configurados en Supabase para no mostrar
# botones que aún no funcionan. Ej.: NEXT_PUBLIC_AUTH_PROVIDERS=google
NEXT_PUBLIC_AUTH_PROVIDERS=

# ---- Traducción automática (Tanda 13) -------------------------------------
# Proveedor de traducción para el pipeline de contenido dinámico.
TRANSLATION_API_KEY=
